{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "lion scan",
            "type": "debugpy",
            "request": "launch",
            "module": "lion.main",
            "args": [
                "scan"
            ]
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "${file}"
            ],
            "console": "integratedTerminal"
        }
    ]
}
